# OpenAI API Key (required)
OPENAI_API_KEY=sk-...

# Daytona API Key (required) - Get from https://app.daytona.io/settings/api-keys
DAYTONA_API_KEY=...

# Daytona API URL (default: Daytona Cloud)
DAYTONA_API_URL=https://app.daytona.io/api

# Daytona Target Region: us | eu
DAYTONA_TARGET=us

# Database URL (SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./workspace.db
